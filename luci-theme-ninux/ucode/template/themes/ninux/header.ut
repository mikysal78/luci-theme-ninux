{#
 luci-theme-ninux - header
 Struttura derivata da luci-theme-bootstrap (Apache-2.0, The LuCI Team).
 Licensed to the public under the Apache License 2.0.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const hostname = striptags(boardinfo.hostname ?? '?');
	const pagetitle = (dispatched ?? node)?.title;

	/* Opzioni in /etc/config/luci, sezione "ninux" (vedi README) */
	const opt = (k, d) => uci.get('luci', 'ninux', k) ?? d;

	let basic = opt('basic', null);
	if (type(basic) == 'string')
		basic = split(trim(basic), /\s+/);

	const cfg = {
		default_mode: (opt('default_mode', 'basic') == 'advanced') ? 'advanced' : 'basic',
		allow_advanced: opt('allow_advanced', '1') != '0',
		basic: (type(basic) == 'array' && length(basic)) ? basic : null
	};

	const logo = opt('logo', '') || `${media}/logo.svg`;
	const brand = opt('brand', '') || 'ninux';

	/* colore d'accento: solo #rgb / #rrggbb, nient'altro finisce nel CSS */
	const color = (k) => match(opt(k, ''), /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/)?.[0];
	const accent = color('accent');
	const accent_dark = color('accent_dark');

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${hostname}${pagetitle ? ` | ${_(pagetitle)}` : ''}`) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">
		<meta name="darkreader-lock">
		<script>
			window.ninux = {{ replace(sprintf('%J', cfg), '<', '\\u003c') }};
			(function(c) {
				var m = null;
				try { m = localStorage.getItem('ninux-mode'); } catch (e) {}
				if (m !== 'basic' && m !== 'advanced') m = c.default_mode;
				if (!c.allow_advanced) m = 'basic';
				c.mode = m;
				document.documentElement.setAttribute('data-mode', m);
			})(window.ninux);
		</script>
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		{% if (accent || accent_dark): %}
		<style>
			{% if (accent): %}:root { --accent: {{ accent }}; }{% endif %}
			{% if (accent_dark): %}@media (prefers-color-scheme: dark) { :root { --accent: {{ accent_dark }}; } }{% endif %}
		</style>
		{% endif %}
		<link rel="icon" href="{{ media }}/favicon.svg" type="image/svg+xml">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ ctx.authsession ? 'logged-in' : 'login' }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<header id="topbar">
			<button type="button" id="nav-toggle" aria-label="{{ _('Menu') }}" aria-controls="menubar" aria-expanded="false">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
			</button>
			<a class="brand" href="/">
				<img src="{{ entityencode(logo, true) }}" alt="{{ entityencode(brand, true) }}" height="28">
				<span class="hostname">{{ hostname }}</span>
			</a>
			<div id="modeswitch"></div>
			<div id="indicators"></div>
		</header>

		<nav id="menubar" aria-label="{{ _('Menu') }}">
			<ul id="mainmenu"></ul>
		</nav>
		<div id="nav-backdrop"></div>

		<div id="layout">

			<main id="maincontent">
				{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message warning">
						<h4>{{ _('No password set!') }}</h4>
						<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup("admin/system/admin")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
						{% endif %}
					</div>
				{% endif %}

				{% if (boardinfo.rootfs_type == "initramfs"): %}
					<div class="alert-message warning">
						<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
						<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
						{% if (dispatcher.lookup("admin/system/flash")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
						{% endif %}
					</div>
				{% endif %}

				<noscript>
					<div class="alert-message warning">
						<h4>{{ _('JavaScript required!') }}</h4>
						<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
					</div>
				</noscript>

				<div id="tabmenu" style="display:none"></div>
		{% endif %}
